# ==============================================================================
# AGENTGUARD Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME=AGENTGUARD
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Logging Configuration (Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=console

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./data/agentguard.db

# Security & CORS (comma-separated origins or JSON array)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

